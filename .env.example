# Local research demonstrator only. Replace all values before any shared deployment.
RISKSHARE_DATABASE_URL=sqlite:///./data/control.sqlite3
RISKSHARE_DATA_DIR=./data
RISKSHARE_REDIS_URL=
RISKSHARE_CONTROL_SECRET=replace-with-at-least-32-random-bytes
RISKSHARE_AUTH_SECRET=replace-with-at-least-32-random-bytes
RISKSHARE_ADMIN_PASSWORD=replace-admin-password
RISKSHARE_OPERATOR_PASSWORD=replace-operator-password
POSTGRES_PASSWORD=replace-with-url-safe-database-password
# Optional for remote-node Compose mode; local mode leaves these unset.
RISKSHARE_NODE_URLS=
RISKSHARE_NODE_CA=./infrastructure/dev-certs/ca.pem
RISKSHARE_CONTROL_CLIENT_CERT=./infrastructure/dev-certs/control-api.pem
RISKSHARE_CONTROL_CLIENT_KEY=./infrastructure/dev-certs/control-api-key.pem
